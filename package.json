{
  "name": "cs-daily",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "content:validate": "pnpm --filter @cs-daily/content validate",
    "db:migrate": "pnpm --filter @cs-daily/api prisma:migrate",
    "db:seed": "pnpm --filter @cs-daily/api prisma:seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
