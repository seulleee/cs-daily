// CS 데일리 — 영속 스키마. 기획서 7절 DDL과 1:1 대응.
// 테이블 소유권(바운디드 컨텍스트)은 각 섹션 주석에 표시. 다른 컨텍스트의 테이블은 읽기 모델(쿼리)에서만 조회한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ========== Identity ==========

enum UserRole {
  user
  admin
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  /// 저장 전 소문자로 정규화 (citext 확장 없이 유일성 보장)
  email       String   @unique
  nickname    String   @unique @db.VarChar(30)
  avatarUrl   String?  @map("avatar_url")
  timezone    String   @default("Asia/Seoul")
  dailyGoal   Int      @default(1) @map("daily_goal") @db.SmallInt
  /// "HH:mm" 로컬 시각. null이면 리마인더 끔
  reminderAt  String?  @map("reminder_at") @db.VarChar(5)
  role        UserRole @default(user)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  accounts        OAuthAccount[]
  refreshTokens   RefreshToken[]
  userTracks      UserTrack[]
  sessions        LessonSession[]
  stats           UserStats?
  dailyActivities DailyActivity[]
  xpEvents        XpEvent[]
  lessonProgress  UserLessonProgress[]
  reviewItems     ReviewItem[]
  notificationLog NotificationLog[]

  @@map("users")
}

model OAuthAccount {
  id             BigInt   @id @default(autoincrement())
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(20)
  providerUserId String   @map("provider_user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ========== Curriculum ==========

model Track {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  name        String
  description String?
  sortOrder   Int     @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  units      Unit[]
  userTracks UserTrack[]

  @@map("tracks")
}

model Unit {
  id        Int    @id @default(autoincrement())
  trackId   Int    @map("track_id")
  slug      String
  name      String
  sortOrder Int    @map("sort_order")

  track   Track    @relation(fields: [trackId], references: [id])
  lessons Lesson[]

  @@unique([trackId, sortOrder])
  @@unique([trackId, slug])
  @@map("units")
}

model Lesson {
  id            Int      @id @default(autoincrement())
  unitId        Int      @map("unit_id")
  slug          String
  name          String
  objective     String?
  /// 핵심 정리 2~4줄 ("용어 — 한 줄 정의"), 레슨 시작 카드에 표시
  keyPoints     String[] @default([]) @map("key_points")
  sortOrder     Int      @map("sort_order")
  questionCount Int      @default(8) @map("question_count") @db.SmallInt

  unit      Unit                 @relation(fields: [unitId], references: [id])
  questions Question[]
  sessions  LessonSession[]
  progress  UserLessonProgress[]

  @@unique([unitId, sortOrder])
  @@unique([unitId, slug])
  @@map("lessons")
}

enum QuestionType {
  single
  multi
  ox
  fill
  order
  match
  code_output
  sql
  short
}

enum QuestionStatus {
  draft
  review
  published
  retired
}

model Question {
  id          String         @id @default(uuid()) @db.Uuid
  /// 콘텐츠 파일의 사람이 읽는 id (database-relational-model-001). 시드 업서트 키
  contentId   String         @unique @map("content_id")
  lessonId    Int            @map("lesson_id")
  type        QuestionType
  /// 클라이언트에 내려가는 지문·보기 (contracts의 유형별 스키마)
  content     Json
  /// 서버 전용 정답. 채점 리포지토리 외에는 select하지 않는다
  answerKey   Json           @map("answer_key")
  explanation String
  difficulty  Int            @db.SmallInt
  tags        String[]       @default([])
  refs        String[]       @default([])
  status      QuestionStatus @default(draft)
  version     Int            @default(1)
  sortOrder   Int            @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  lesson      Lesson       @relation(fields: [lessonId], references: [id])
  answers     Answer[]
  reviewItems ReviewItem[]

  @@index([lessonId, sortOrder])
  @@index([tags], type: Gin)
  @@map("questions")
}

model UserTrack {
  userId  String   @map("user_id") @db.Uuid
  trackId Int      @map("track_id")
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id])

  @@id([userId, trackId])
  @@map("user_tracks")
}

// ========== Learning (핵심) ==========

enum SessionKind {
  lesson
  review
  placement
}

model LessonSession {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  lessonId     Int?        @map("lesson_id")
  kind         SessionKind @default(lesson)
  /// 출제 순서 고정. 복귀·재현·치팅 검증의 기준
  questionIds  String[]    @map("question_ids") @db.Uuid
  startedAt    DateTime    @default(now()) @map("started_at") @db.Timestamptz
  finishedAt   DateTime?   @map("finished_at") @db.Timestamptz
  correctCount Int         @default(0) @map("correct_count") @db.SmallInt
  xpEarned     Int         @default(0) @map("xp_earned")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson? @relation(fields: [lessonId], references: [id])
  answers Answer[]

  @@index([userId, finishedAt])
  @@map("lesson_sessions")
}

model Answer {
  id              BigInt   @id @default(autoincrement())
  sessionId       String   @map("session_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  questionId      String   @map("question_id") @db.Uuid
  questionVersion Int      @map("question_version")
  userAnswer      Json     @map("user_answer")
  isCorrect       Boolean  @map("is_correct")
  timeMs          Int?     @map("time_ms")
  answeredAt      DateTime @default(now()) @map("answered_at") @db.Timestamptz

  session  LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question      @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
  @@index([userId, questionId, answeredAt(sort: Desc)])
  @@map("answers")
}

// ========== Progression ==========

model UserLessonProgress {
  userId         String    @map("user_id") @db.Uuid
  lessonId       Int       @map("lesson_id")
  bestScore      Int       @default(0) @map("best_score") @db.SmallInt
  completedCount Int       @default(0) @map("completed_count")
  completedAt    DateTime? @map("completed_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@id([userId, lessonId])
  @@map("user_lesson_progress")
}

model UserStats {
  userId         String    @id @map("user_id") @db.Uuid
  totalXp        BigInt    @default(0) @map("total_xp")
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  /// 사용자 타임존 기준 날짜 (YYYY-MM-DD)
  lastActiveDate DateTime? @map("last_active_date") @db.Date
  freezeCount    Int       @default(2) @map("freeze_count") @db.SmallInt
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

/// 스트릭·캘린더의 원천. 사용자 타임존 날짜 단위
model DailyActivity {
  userId           String   @map("user_id") @db.Uuid
  activityDate     DateTime @map("activity_date") @db.Date
  xp               Int      @default(0)
  lessonsCompleted Int      @default(0) @map("lessons_completed") @db.SmallInt
  usedFreeze       Boolean  @default(false) @map("used_freeze")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, activityDate])
  @@map("daily_activity")
}

/// XP 원장 (append-only). total_xp는 이 테이블의 합계 캐시
model XpEvent {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  amount    Int
  reason    String
  refId     String?  @map("ref_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("xp_events")
}

// ========== Review ==========

model ReviewItem {
  userId         String    @map("user_id") @db.Uuid
  questionId     String    @map("question_id") @db.Uuid
  easeFactor     Decimal   @default(2.5) @map("ease_factor") @db.Decimal(4, 2)
  intervalDays   Int       @default(0) @map("interval_days")
  repetitions    Int       @default(0)
  dueAt          DateTime  @map("due_at") @db.Timestamptz
  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@id([userId, questionId])
  @@index([userId, dueAt])
  @@map("review_items")
}

// ========== Notification ==========

model NotificationLog {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  kind      String   @db.VarChar(30)
  /// 중복 발송 방지 키 (reminder:2026-10-06)
  slot      String
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, slot])
  @@map("notification_log")
}

// ========== Jobs (배치 멱등성) ==========

model JobRun {
  job        String
  slot       String
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz
  error      String?

  @@id([job, slot])
  @@map("job_runs")
}
