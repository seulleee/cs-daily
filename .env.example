# ---------- apps/api ----------
# 로컬: docker compose up -d 후 아래 값 그대로 사용
DATABASE_URL="postgresql://csdaily:csdaily@localhost:5432/csdaily?schema=public"
# Supabase 배포 시: Project Settings > Database > Connection string (Transaction pooler, port 6543)에 ?pgbouncer=true 추가
# DIRECT_URL은 마이그레이션 전용(Session pooler, port 5432)
DIRECT_URL="postgresql://csdaily:csdaily@localhost:5432/csdaily?schema=public"

PORT=4000
API_BASE_URL="http://localhost:4000"
WEB_BASE_URL="http://localhost:3000"
NODE_ENV=development

# JWT (openssl rand -base64 48)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="14d"

# OAuth — GitHub: Settings > Developer settings > OAuth Apps, callback = {API_BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Google: GCP Console > APIs & Services > Credentials, callback = {API_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 배치 tick 엔드포인트 보호. Cloud Run에서는 OIDC(IAM)로 대체하고 로컬·staging은 이 값으로 Bearer 인증
JOBS_SECRET="change-me-jobs"

# Resend (무료 3,000통/월)
RESEND_API_KEY=""
MAIL_FROM="CS 데일리 <noreply@yourdomain.com>"

# 관측성 (선택)
SENTRY_DSN=""

# ---------- apps/web ----------
NEXT_PUBLIC_API_URL="http://localhost:4000"
# 서버 컴포넌트가 API를 직접 부를 때 쓰는 내부 주소 (Vercel에서는 Cloud Run URL)
API_INTERNAL_URL="http://localhost:4000"
