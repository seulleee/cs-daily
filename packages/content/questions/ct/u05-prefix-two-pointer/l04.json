      "content": {
        "prompt": "출력되는 값은?",
        "options": [
          "1 2 3 2 2",
          "1 3 3 2 2",
          "1 3 3 3 2"
        ],
        "variants": {
          "python": {
            "code": {
              "language": "python",
              "source": "n = 5\nD = [0] * (n + 1)\nfor l, r, v in [(0, 2, 1), (1, 4, 2)]:\n    D[l] += v\n    D[r + 1] -= v\ncur = 0\nfor i in range(n):\n    cur += D[i]\n    print(cur, end=' ')"
            }
          },
          "java": {
            "code": {
              "language": "java",
              "source": "int n = 5;\nint[] D = new int[n + 1];\nint[][] ops = {{0, 2, 1}, {1, 4, 2}};\nfor (int[] o : ops) {\n    D[o[0]] += o[2];\n    D[o[1] + 1] -= o[2];\n}\nint cur = 0;\nfor (int i = 0; i < n; i++) {\n    cur += D[i];\n    System.out.print(cur + \" \");\n}"
            }
          },
          "javascript": {
            "code": {
              "language": "javascript",
              "source": "const n = 5;\nconst D = new Array(n + 1).fill(0);\nconst ops = [[0, 2, 1], [1, 4, 2]];\nfor (const [l, r, v] of ops) {\n  D[l] += v;\n  D[r + 1] -= v;\n}\nlet cur = 0;\nconst out = D.slice(0, n).map(d => (cur += d));\nconsole.log(out.join(' '));"
            }
          },
          "cpp": {
            "code": {
              "language": "cpp",
              "source": "int n = 5;\nvector<int> D(n + 1);\nint ops[2][3] = {{0, 2, 1}, {1, 4, 2}};\nfor (auto& o : ops) {\n    D[o[0]] += o[2];\n    D[o[1] + 1] -= o[2];\n}\nint cur = 0;\nfor (int i = 0; i < n; i++) {\n    cur += D[i];\n    cout << cur << ' ';\n}"
            }
          }
        }
      },
