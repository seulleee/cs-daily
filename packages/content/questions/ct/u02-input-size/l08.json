      "content": {
        "prompt": "n ≤ 10⁵이고 제한이 1초일 때 이 코드는?",
        "options": [
          "시간 안에 끝남",
          "시간 초과"
        ],
        "variants": {
          "python": {
            "code": {
              "language": "python",
              "source": "cnt = 0\nfor i in range(n):\n    for j in range(i + 1, n):\n        cnt += 1"
            }
          },
          "java": {
            "code": {
              "language": "java",
              "source": "long cnt = 0;\nfor (int i = 0; i < n; i++) {\n    for (int j = i + 1; j < n; j++) {\n        cnt++;\n    }\n}"
            }
          },
          "javascript": {
            "code": {
              "language": "javascript",
              "source": "let cnt = 0;\nfor (let i = 0; i < n; i++) {\n  for (let j = i + 1; j < n; j++) {\n    cnt++;\n  }\n}"
            }
          },
          "cpp": {
            "code": {
              "language": "cpp",
              "source": "long long cnt = 0;\nfor (int i = 0; i < n; i++) {\n    for (int j = i + 1; j < n; j++) {\n        cnt++;\n    }\n}"
            }
          }
        }
      },
      "answer_key": {
        "variants": {
          "python": {
            "index": 1
          },
          "java": {
            "index": 1
          },
          "javascript": {
            "index": 1
          },
          "cpp": {
            "index": 1
          }
        }
