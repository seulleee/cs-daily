      "content": {
        "prompt": "좌표 압축에서 중복을 제거한다. 빈칸은?",
        "variants": {
          "python": {
            "code": {
              "language": "python",
              "source": "from bisect import bisect_left\ndef compress(a):\n    xs = sorted(___(a))\n    return [bisect_left(xs, v) for v in a]"
            }
          },
          "java": {
            "code": {
              "language": "java",
              "source": "static int[] compress(int[] a) {\n    int[] xs = Arrays.stream(a).___()\n        .sorted().toArray();\n    int[] r = new int[a.length];\n    for (int i = 0; i < a.length; i++)\n        r[i] = Arrays.binarySearch(xs, a[i]);\n    return r;\n}"
            }
          },
          "javascript": {
            "code": {
              "language": "javascript",
              "source": "function compress(a) {\n  const xs = [...new ___(a)];\n  xs.sort((x, y) => x - y);\n  const id = new Map(xs.map((v, i) => [v, i]));\n  return a.map((v) => id.get(v));\n}"
            }
          },
          "cpp": {
            "code": {
              "language": "cpp",
              "source": "vector<int> compress(const vector<int>& a) {\n    vector<int> xs = a;\n    sort(xs.begin(), xs.end());\n    auto it = ___(xs.begin(), xs.end());\n    xs.erase(it, xs.end());\n    vector<int> r;\n    for (int v : a)\n        r.push_back(lower_bound(xs.begin(),\n            xs.end(), v) - xs.begin());\n    return r;\n}"
            }
          }
        }
      },
