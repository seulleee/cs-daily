      "content": {
        "prompt": "이 코드의 DP 구현 방식은?",
        "options": [
          "상향식",
          "하향식"
        ],
        "variants": {
          "python": {
            "code": {
              "language": "python",
              "source": "memo = [-1] * 100\ndef f(i):\n    if i <= 1:\n        return 1\n    if memo[i] == -1:\n        memo[i] = f(i - 1) + f(i - 2)\n    return memo[i]"
            }
          },
          "java": {
            "code": {
              "language": "java",
              "source": "Long[] memo = new Long[100];\nlong f(int i) {\n    if (i <= 1) return 1;\n    if (memo[i] == null)\n        memo[i] = f(i - 1) + f(i - 2);\n    return memo[i];\n}"
            }
          },
          "javascript": {
            "code": {
              "language": "javascript",
              "source": "const memo = new Array(100).fill(-1);\nfunction f(i) {\n  if (i <= 1) return 1;\n  if (memo[i] === -1) {\n    memo[i] = f(i - 1) + f(i - 2);\n  }\n  return memo[i];\n}"
            }
          },
          "cpp": {
            "code": {
              "language": "cpp",
              "source": "vector<long long> memo(100, -1);\nlong long f(int i) {\n    if (i <= 1) return 1;\n    if (memo[i] == -1)\n        memo[i] = f(i - 1) + f(i - 2);\n    return memo[i];\n}"
            }
          }
        }
      },
