          "상향식"
        ],
        "variants": {
          "python": {
            "code": {
              "language": "python",
              "source": "dp = [0] * (n + 1)\ndp[0] = dp[1] = 1\nfor i in range(2, n + 1):\n    dp[i] = dp[i - 1] + dp[i - 2]"
            }
          },
          "java": {
            "code": {
              "language": "java",
              "source": "long[] dp = new long[n + 1];\ndp[0] = dp[1] = 1;\nfor (int i = 2; i <= n; i++)\n    dp[i] = dp[i - 1] + dp[i - 2];"
            }
          },
          "javascript": {
            "code": {
              "language": "javascript",
              "source": "const dp = new Array(n + 1).fill(0);\ndp[0] = dp[1] = 1;\nfor (let i = 2; i <= n; i++) {\n  dp[i] = dp[i - 1] + dp[i - 2];\n}"
            }
          },
          "cpp": {
            "code": {
              "language": "cpp",
              "source": "vector<long long> dp(n + 1);\ndp[0] = dp[1] = 1;\nfor (int i = 2; i <= n; i++)\n    dp[i] = dp[i - 1] + dp[i - 2];"
            }
          }
        }
      },
