      "content": {
        "prompt": "f(5)의 반환값은?",
        "options": [
          "8",
          "0",
          "5"
        ],
        "variants": {
          "python": {
            "code": {
              "language": "python",
              "source": "memo = [0] * 10\ndef f(i):\n    if i <= 1:\n        return 1\n    if memo[i] != -1:\n        return memo[i]\n    memo[i] = f(i - 1) + f(i - 2)\n    return memo[i]"
            }
          },
          "java": {
            "code": {
              "language": "java",
              "source": "long[] memo = new long[10];\nlong f(int i) {\n    if (i <= 1) return 1;\n    if (memo[i] != -1) return memo[i];\n    return memo[i] = f(i - 1) + f(i - 2);\n}"
            }
          },
          "javascript": {
            "code": {
              "language": "javascript",
              "source": "const memo = new Array(10).fill(0);\nfunction f(i) {\n  if (i <= 1) return 1;\n  if (memo[i] !== -1) return memo[i];\n  return (memo[i] = f(i - 1) + f(i - 2));\n}"
            }
          },
          "cpp": {
            "code": {
              "language": "cpp",
              "source": "vector<long long> memo(10);\nlong long f(int i) {\n    if (i <= 1) return 1;\n    if (memo[i] != -1) return memo[i];\n    return memo[i] = f(i - 1) + f(i - 2);\n}"
            }
          }
        }
      },
